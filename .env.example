# Firebase-webconfig voor De Dagkrant (kopieer naar .env en vul in).
# Deze waarden zijn niet geheim (ze horen in de client), maar staan in env-vars
# zodat ze makkelijk per omgeving in te stellen zijn (lokaal + Vercel).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
